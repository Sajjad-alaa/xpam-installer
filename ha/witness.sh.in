#!/usr/bin/env bash
# XPAM high availability witness: one vote (an etcd member) and no XPAM data. Needs Docker only.
# Generated by 'xpamctl ha init'. Run as root on the witness machine; run again to update.
set -euo pipefail
cd "$(dirname "$0")"
THIS=@THIS@
CLUSTER='@CLUSTER@'
STATE=@STATE@
ALLOWED='@ALLOWED@'
command -v docker >/dev/null || { echo "Install Docker first"; exit 1; }
ip -o -4 addr show | awk '{print $4}' | cut -d/ -f1 | grep -qx "$THIS" || { echo "This machine is not $THIS"; exit 1; }
install -d -m 700 /opt/xpam-witness /opt/xpam-witness/certs /opt/xpam-witness/etcd
if [[ "$STATE" == "existing" ]]; then
  rm -rf /opt/xpam-witness/etcd/member  # (a replacement witness starts empty and receives the vote's data)
fi
if [[ "$STATE" == "keep" ]]; then
  STATE=existing  # (new certificates only: the vote's data stays)
fi
install -m 600 certs/ca.crt certs/node.crt certs/node.key /opt/xpam-witness/certs/

docker rm -f xpam_etcd_witness >/dev/null 2>&1 || true
docker run -d --name xpam_etcd_witness --restart always \
  -p "$THIS:2379:2379" -p "$THIS:2380:2380" \
  -v /opt/xpam-witness/etcd:/etcd-data -v /opt/xpam-witness/certs:/certs:ro \
  gcr.io/etcd-development/etcd:v3.5.21 /usr/local/bin/etcd --name=xpam-witness --data-dir=/etcd-data \
  --listen-peer-urls=https://0.0.0.0:2380 --listen-client-urls=https://0.0.0.0:2379 \
  --advertise-client-urls="https://$THIS:2379" --initial-advertise-peer-urls="https://$THIS:2380" \
  --initial-cluster="$CLUSTER" --initial-cluster-token=xpam-ha --initial-cluster-state="$STATE" \
  --client-cert-auth --trusted-ca-file=/certs/ca.crt --cert-file=/certs/node.crt --key-file=/certs/node.key \
  --peer-client-cert-auth --peer-trusted-ca-file=/certs/ca.crt --peer-cert-file=/certs/node.crt \
  --peer-key-file=/certs/node.key --heartbeat-interval=250 --election-timeout=2500 --auto-compaction-retention=1 >/dev/null

# only the two XPAM servers may reach the vote (Docker-published ports bypass firewalld: DOCKER-USER)
cat > /opt/xpam-witness/firewall.sh <<FW
#!/bin/sh
# only connections addressed to the witness are checked (its own outgoing connections are not)
iptables -N XPAM-HA 2>/dev/null; iptables -F XPAM-HA
iptables -A XPAM-HA -i docker0 -j RETURN
iptables -A XPAM-HA -i br-+ -j RETURN
for ip in $ALLOWED; do iptables -A XPAM-HA -s \$ip -j RETURN; done
iptables -A XPAM-HA -j DROP
while iptables -D DOCKER-USER ! -i br-+ -p tcp -m multiport --dports 2379,2380 -j XPAM-HA 2>/dev/null; do :; done
iptables -C DOCKER-USER -p tcp -m multiport --dports 2379,2380 -m conntrack --ctorigdst $THIS -j XPAM-HA 2>/dev/null || \
  iptables -I DOCKER-USER -p tcp -m multiport --dports 2379,2380 -m conntrack --ctorigdst $THIS -j XPAM-HA
FW
chmod 700 /opt/xpam-witness/firewall.sh
cat > /etc/systemd/system/xpam-witness-firewall.service <<UNIT
[Unit]
Description=XPAM witness firewall rule
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
ExecStart=/opt/xpam-witness/firewall.sh
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload && systemctl enable --now xpam-witness-firewall >/dev/null 2>&1 || /opt/xpam-witness/firewall.sh
echo "XPAM witness running on $THIS (only $ALLOWED may connect)."
