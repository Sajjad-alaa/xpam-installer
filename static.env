# The XPAM release this installer installs (recorded as CURRENT_VERSION in config.txt)
export VERSION=v5.1.20
# Default tag of the XPAM images (xpam/core, xpam/web, ...); XPAM_VERSION in config.txt overrides it.
export XPAM_DEFAULT_VERSION=v5.1.20
# Where the XPAM images are downloaded from. XPAM_IMAGE_REGISTRY in config.txt overrides it
# ("local" = never download, use the images already on the server).
export XPAM_DEFAULT_IMAGE_REGISTRY=ghcr.io/sajjad-alaa/xpam
# Where this installer itself comes from (quick_start.sh, xpamctl upgrade)
export XPAM_INSTALLER_REPO=https://github.com/Sajjad-alaa/xpam-installer.git
export XPAM_INSTALLER_BRANCH=xpam
